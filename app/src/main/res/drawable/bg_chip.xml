<?xml version="1.0" encoding="utf-8"?>
<!-- Quick filter chip: dark when selected (reference "Available now"), light outline otherwise (NEW in phase 7) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22000000">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/asanni_segment_selected_fill" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/asanni_search_fill" />
                    <stroke android:width="1dp" android:color="@color/asanni_outline" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>