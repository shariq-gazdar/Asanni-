<?xml version="1.0" encoding="utf-8"?>
<!-- Review text box. NEW in phase 9 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/desc_surface" />
            <stroke android:width="2dp" android:color="@color/desc_red" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/desc_surface" />
            <stroke android:width="1dp" android:color="@color/desc_divider" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>