<?xml version="1.0" encoding="utf-8"?>
<!-- Form field box.
     error    = view.setActivated(true)  -> red border
     disabled = enabled="false"          -> warm grey fill (locked Country field)
     default  = white with hairline border; ripple on tap -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#14000000">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/asanni_surface" />
                    <stroke android:width="1.5dp" android:color="@color/asanni_welcome_accent" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/asanni_field_locked" />
                    <stroke android:width="1dp" android:color="@color/asanni_card_default_border" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/asanni_surface" />
                    <stroke android:width="1dp" android:color="@color/asanni_outline" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>