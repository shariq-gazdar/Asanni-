<?xml version="1.0" encoding="utf-8"?>
<!-- White pill with a thin grey outline (Google light-theme button colors) + ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F000000">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/asanni_google_button_fill" />
            <stroke android:width="1dp" android:color="@color/asanni_google_button_stroke" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</ripple>