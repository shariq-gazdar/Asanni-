<?xml version="1.0" encoding="utf-8"?>
<!-- White pill with a thin outline: secondary button ("Enter area manually"). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F000000">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/asanni_surface" />
            <stroke android:width="1dp" android:color="@color/asanni_outline" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</ripple>