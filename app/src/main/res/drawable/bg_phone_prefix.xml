<?xml version="1.0" encoding="utf-8"?>
<!-- "+92" box inside the phone field: a thin divider on its right edge only. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="-2dp"
        android:left="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/asanni_outline" />
        </shape>
    </item>
</layer-list>