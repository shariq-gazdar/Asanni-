<?xml version="1.0" encoding="utf-8"?>
<!-- Role card background. state_selected is set from Java (view.setSelected). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/asanni_card_selected_fill" />
            <stroke android:width="1.5dp" android:color="@color/asanni_card_selected_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/asanni_card_default_fill" />
            <stroke android:width="1dp" android:color="@color/asanni_card_default_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>