<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded square behind the role icon: pink when selected, white otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/asanni_tile_selected_fill" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/asanni_tile_default_fill" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>