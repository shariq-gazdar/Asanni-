<?xml version="1.0" encoding="utf-8"?>
<!-- Appearance pill: filled when selected (white on dark theme, dark on light theme), outlined otherwise. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F808080">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/asanni_segment_selected_fill" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/asanni_surface" />
                    <stroke android:width="1dp" android:color="@color/asanni_outline" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>