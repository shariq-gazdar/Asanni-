<?xml version="1.0" encoding="utf-8"?>
<!--
    [UI ASSET] Restaurant image placeholder (NEW in phase 6). Shown while a restaurant's real logo
    loads, or when the restaurant has no logo / the image is broken. Actual restaurant logos come
    from Firestore (desktop app); this file is only the fallback.
    To use your own artwork from the ui folder: DELETE this file and add
    res/drawable-nodpi/restaurant_placeholder.png (same name, no code change).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/asanni_image_placeholder" /></shape></item>
    <item android:width="40dp" android:height="40dp" android:gravity="center"
        android:drawable="@drawable/ic_storefront_tinted" />
</layer-list>