<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - Allow Location screen  (NEW)
    Location: app/src/main/res/layout/activity_allow_location.xml

    Structure (matches the reference screenshot):
      1. Top bar        back button + "Set your location"
      2. Map card       sample map illustration, red pin with soft halo, area chip
      3. Heading        "What's open around you, right now."
      4. Description    how location is used
      5. Info box       privacy note with icon
      6. Status line    permission / detection messages (hidden unless needed)
      7. Primary button "Allow while using app"   (red pill, location arrow icon)
      8. Second button  "Enter area manually"     (white outlined pill)

    The map card stretches to use spare height; on small phones the page scrolls instead.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/allow_location_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_welcome_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- ============ 1. TOP BAR ============ -->
            <LinearLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/button_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:contentDescription="@string/back"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_close_button"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>

                <!-- [EDIT TEXT] Small top title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/allow_location_top_title"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ============ 2. MAP CARD ============ -->
            <FrameLayout
                android:id="@+id/map_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_map_card"
                android:clipToOutline="true"
                android:minHeight="210dp">

                <!-- [UI ASSET] Replace with the ASANNI sample map illustration from the ui folder.
                     Default: res/drawable/asanni_location_map.xml (original vector, decorative only).
                     To use a PNG: delete that .xml and add res/drawable-nodpi/asanni_location_map.png -->
                <ImageView
                    android:id="@+id/map_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/allow_location_map_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/asanni_location_map" />

                <!-- Pin with a soft halo (the halo pulses gently a few times, then stops) -->
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="noHideDescendants">

                    <View
                        android:id="@+id/map_pin_halo"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_map_pin_halo" />

                    <View
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_map_pin_halo" />

                    <ImageView
                        android:id="@+id/map_pin"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_map_pin"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_location_pin" />
                </FrameLayout>

                <!-- Area chip. Shows the sample label until a location is actually detected. -->
                <!-- [EDIT TEXT] Map chip (sample label: allow_location_map_chip_sample) -->
                <TextView
                    android:id="@+id/map_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_live_chip"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="@string/allow_location_map_chip_sample"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- ============ 3. HEADING ============ -->
            <!-- [EDIT TEXT] Allow Location heading -->
            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:lineSpacingMultiplier="1.05"
                android:text="@string/allow_location_title"
                android:textColor="@color/asanni_welcome_ink"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:targetApi="p" />

            <!-- ============ 4. DESCRIPTION ============ -->
            <!-- [EDIT TEXT] Location permission explanation -->
            <TextView
                android:id="@+id/text_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/allow_location_description"
                android:textColor="@color/asanni_welcome_muted"
                android:textSize="13sp" />

            <!-- ============ 5. INFO BOX ============ -->
            <LinearLayout
                android:id="@+id/info_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_info_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield_check"
                    android:tint="@color/asanni_welcome_muted" />

                <!-- [EDIT TEXT] Privacy note -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/allow_location_privacy_note"
                    android:textColor="@color/asanni_welcome_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ============ 6..8 ACTIONS ============ -->
            <LinearLayout
                android:id="@+id/bottom_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- Status line: denied / location off / detected result / errors -->
                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.1"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Primary button. Label changes with the state (Allow / Finding you / Use <area> ...) -->
                <LinearLayout
                    android:id="@+id/button_allow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_get_started_button"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <ImageView
                        android:id="@+id/allow_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_near_me" />

                    <ProgressBar
                        android:id="@+id/allow_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:indeterminateTint="@color/asanni_welcome_on_accent"
                        android:visibility="gone" />

                    <!-- [EDIT TEXT] Allow Location button (allow_location_button) -->
                    <TextView
                        android:id="@+id/allow_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/allow_location_button"
                        android:textColor="@color/asanni_welcome_on_accent"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- [EDIT TEXT] Manual location option (enter_location_manually) -->
                <TextView
                    android:id="@+id/button_manual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_outline_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/enter_location_manually"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>