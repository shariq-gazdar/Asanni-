<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - Choose page  (MODIFIED in phase 3: diner only)
    Location: app/src/main/res/layout/activity_choose_role.xml

    The restaurant manager card was removed: the Android app is for diners only.
    The diner card keeps the reference look (selected state: red border, pink icon tile,
    "Selected" mark). The flexible space now takes the room the second card used,
    so the button stays at the bottom exactly as in the reference.

      1. Top bar        close button + "Welcome to ASANNI"
      2. Heading        + line explaining ASANNI is for diners
      3. Diner card     (always selected; display only)
      4. Flexible space
      5. Error line     (only if saving the choice fails)
      6. Continue button
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/choose_role_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_welcome_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ============ 1. TOP BAR ============ -->
            <LinearLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Close button: 48dp touch target, drawn as a 36dp circle -->
                <FrameLayout
                    android:id="@+id/button_close"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:contentDescription="@string/close"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_close_button"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_close" />
                </FrameLayout>

                <!-- [EDIT TEXT] Small top title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/choose_role_top_title"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ============ 2. HEADING ============ -->
            <!-- [EDIT TEXT] Main page heading -->
            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:accessibilityHeading="true"
                android:lineSpacingMultiplier="1.05"
                android:text="@string/choose_role_title"
                android:textColor="@color/asanni_welcome_ink"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:targetApi="p" />

            <!-- [EDIT TEXT] Supporting description (explains the app is for diners) -->
            <TextView
                android:id="@+id/text_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/choose_role_description"
                android:textColor="@color/asanni_welcome_muted"
                android:textSize="13sp" />

            <!-- ============ 3. DINER CARD (display only, always selected) ============ -->
            <LinearLayout
                android:id="@+id/card_diner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_role_card"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- [UI ASSET] Replace with the diner illustration from the ui folder.
                     Default is the vector res/drawable/ic_role_diner.xml. To use your own,
                     add res/drawable/ic_role_diner.png (delete the .xml first). -->
                <ImageView
                    android:id="@+id/icon_diner"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_role_icon_tile"
                    android:importantForAccessibility="no"
                    android:padding="13dp"
                    android:src="@drawable/ic_role_diner"
                    android:tint="@color/role_icon_tint" />

                <!-- [EDIT TEXT] Diner option title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/role_diner_title"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- [EDIT TEXT] Diner option description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.1"
                    android:text="@string/role_diner_description"
                    android:textColor="@color/asanni_welcome_muted"
                    android:textSize="13sp" />

                <!-- "Selected" marker (from the reference) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle"
                        android:tint="@color/asanni_welcome_accent" />

                    <!-- [EDIT TEXT] "Selected" label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/role_selected_label"
                        android:textColor="@color/asanni_welcome_accent"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 4. FLEXIBLE SPACE (pushes the button to the bottom) ============ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:importantForAccessibility="no" />

            <!-- ============ 5. ERROR LINE ============ -->
            <TextView
                android:id="@+id/text_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@color/asanni_welcome_accent"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- ============ 6. CONTINUE BUTTON ============ -->
            <!-- [EDIT TEXT] Primary button label: continue_as_diner -->
            <TextView
                android:id="@+id/button_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_get_started_button"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minHeight="56dp"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp"
                android:text="@string/continue_as_diner"
                android:textColor="@color/asanni_welcome_on_accent"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>