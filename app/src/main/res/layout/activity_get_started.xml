<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/get_started_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_welcome_background">

    <ScrollView
        android:id="@+id/get_started_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!--LOGO BLOCK -->
            <LinearLayout
                android:id="@+id/logo_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- logo image view -->
                <ImageView
                    android:id="@+id/logo_image"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/brand_name"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <!-- text fallback used until asanni_logo exists -->
                <TextView
                    android:id="@+id/logo_wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:text="@string/brand_name"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="44sp" />

            </LinearLayout>

            <!-- EYEBROW -->

            <TextView
                android:id="@+id/text_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="@string/welcome_eyebrow"
                android:textAllCaps="true"
                android:textColor="@color/asanni_welcome_accent"
                android:textSize="11sp" />

            <!-- HEADING -->
            <!-- Main welcome heading -->
            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif"
                android:lineSpacingMultiplier="1.05"
                android:text="@string/welcome_title"
                android:textColor="@color/asanni_welcome_ink"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:targetApi="p" />

            <!-- DESCRIPTION -->
            <!-- Welcome description -->
            <TextView
                android:id="@+id/text_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/welcome_description"
                android:textColor="@color/asanni_welcome_muted"
                android:textSize="14sp" />

            <!-- HERO CARD -->

            <FrameLayout
                android:id="@+id/hero_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="24dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hero_card"
                android:clipToOutline="true"
                android:minHeight="220dp">


                <ImageView
                    android:id="@+id/hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/welcome_hero_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/welcome_hero_restaurant" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_hero_scrim"
                    android:importantForAccessibility="no" />

                <!-- "Live tables" chip -->
                <LinearLayout
                    android:id="@+id/chip_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_live_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp">

                    <View
                        android:id="@+id/chip_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_live_dot"
                        android:importantForAccessibility="no" />

                    <!-- Live-tables chip. SAMPLE value only - no backend yet. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/welcome_live_chip"
                        android:textColor="@color/asanni_welcome_ink"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- PRIMARY BUTTON -->

            <LinearLayout
                android:id="@+id/button_get_started"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_get_started_button"
                android:clickable="true"
                android:contentDescription="@string/get_started_button"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_forward" />

                <!-- Primary button label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/get_started_button"
                    android:textColor="@color/asanni_welcome_on_accent"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>