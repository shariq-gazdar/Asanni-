<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - Google Login screen  (NEW)
    Location: app/src/main/res/layout/activity_google_login.xml

    ************************************************************************************
    PROVISIONAL DESIGN. Your reference image for this page was not provided yet.
    This layout reuses the ASANNI look from Get Started / Choose Role so it fits the app,
    but it is NOT a copy of your reference. Send the image and this file will be redone.
    Keep the android:id values when redesigning: GoogleLoginActivity.java depends on them.
    ************************************************************************************
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_welcome_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ============ TOP BAR ============ -->
            <LinearLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/button_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:contentDescription="@string/back"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_close_button"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>

                <!-- [EDIT TEXT] Small top title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/login_top_title"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- [EDIT TEXT] Login heading -->
            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:accessibilityHeading="true"
                android:text="@string/login_title"
                android:textColor="@color/asanni_welcome_ink"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:targetApi="p" />

            <!-- [EDIT TEXT] Supporting description -->
            <TextView
                android:id="@+id/text_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.1"
                android:text="@string/login_description"
                android:textColor="@color/asanni_welcome_muted"
                android:textSize="14sp" />

            <!-- ============ ILLUSTRATION (fills spare height) ============ -->
            <FrameLayout
                android:id="@+id/login_illustration_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="24dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hero_card"
                android:clipToOutline="true"
                android:minHeight="180dp">

                <!-- [UI ASSET] Replace with the Google login illustration from the ui folder.
                     Add res/drawable-nodpi/login_illustration.webp (or .jpg/.png). Java loads it
                     automatically when it exists; until then the Get Started hero image is shown. -->
                <ImageView
                    android:id="@+id/login_illustration"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/login_illustration_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/welcome_hero_restaurant" />
            </FrameLayout>

            <!-- ============ BOTTOM ACTIONS ============ -->
            <LinearLayout
                android:id="@+id/bottom_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <!-- Error / status message (hidden unless something went wrong) -->
                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textColor="@color/asanni_welcome_accent"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Google button, styled after Google's branding guidelines (light theme):
                     white fill, #747775 1dp outline, #1F1F1F text, official "G" logo on the left. -->
                <LinearLayout
                    android:id="@+id/button_google"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_google_button"
                    android:clickable="true"
                    android:contentDescription="@string/login_google_button"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <!-- [UI ASSET] Official Google "G" logo. Download it from Google's sign-in
                         branding page and save as res/drawable/ic_google_logo.xml (or .png).
                         Do not redraw it. Hidden automatically until the file exists. -->
                    <ImageView
                        android:id="@+id/google_logo"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                    <!-- [EDIT TEXT] Google Sign-In button label (strings: login_google_button).
                         Google allows "Sign in with Google", "Sign up with Google" or "Continue with Google". -->
                    <TextView
                        android:id="@+id/button_google_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/login_google_button"
                        android:textColor="@color/asanni_google_button_text"
                        android:textSize="15sp" />

                    <ProgressBar
                        android:id="@+id/progress_google"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="12dp"
                        android:importantForAccessibility="no"
                        android:indeterminateTint="@color/asanni_welcome_accent"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Shown only if sign-in worked but the profile could not be loaded -->
                <!-- [EDIT TEXT] Use a different account -->
                <TextView
                    android:id="@+id/button_use_other_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/login_use_other_account"
                    android:textColor="@color/asanni_welcome_accent"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- [EDIT TEXT] Privacy reassurance -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/login_privacy_note"
                    android:textColor="@color/asanni_welcome_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>