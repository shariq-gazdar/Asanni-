<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - Home  (REWRITTEN in phase 6)
    Location: app/src/main/res/layout/activity_home.xml

    Four sections with a bottom navigation bar, in this order: Discover, Map, Saved, Profile.
      Discover  @id/section_discover (layout/view_discover.xml)
      Map       @id/section_map      intentionally blank in phase 6 (map comes later)
      Saved     @id/section_saved    intentionally blank in phase 6 (saved restaurants come later)
      Profile   opens the existing Settings page (no duplicate screen)
    All sections stay in memory, so switching tabs never reloads Discover.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_discover_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/home_sections"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/section_discover"
                layout="@layout/view_discover" />

            <!-- MAP (phase 6: blank on purpose; no map tiles, API keys or fake pins) -->
            <FrameLayout
                android:id="@+id/section_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/map_placeholder_description"
                android:focusable="true"
                android:visibility="gone" />

            <!-- SAVED (phase 6: blank on purpose; no fake saved restaurants) -->
            <FrameLayout
                android:id="@+id/section_saved"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/saved_placeholder_description"
                android:focusable="true"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom navigation. Bottom padding for the system navigation bar is added in code. -->
        <LinearLayout
            android:id="@+id/home_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_bar"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <include android:id="@+id/nav_discover" layout="@layout/item_nav_tab" />
            <include android:id="@+id/nav_map" layout="@layout/item_nav_tab" />
            <include android:id="@+id/nav_saved" layout="@layout/item_nav_tab" />
            <include android:id="@+id/nav_profile" layout="@layout/item_nav_tab" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>