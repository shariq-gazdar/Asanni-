<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - Info (your information)  (NEW in phase 4)
    Location: app/src/main/res/layout/activity_info.xml
    No reference image: built from the same pieces as the Settings reference (top bar, rounded
    cards, red section labels, rows with icons) so the two pages feel like one.
      1. Top bar               4. CONTACT card: email (read-only) + phone (verified status)
      2. Profile picture       5. Status line
      3. NAME card (editable)  6. Sign out
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/info_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_welcome_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ============ 1. TOP BAR ============ -->
            <LinearLayout
                android:id="@+id/top_bar"
                style="@style/AsanniTopBar">

                <FrameLayout
                    android:id="@+id/button_back"
                    style="@style/AsanniTopBarButton"
                    android:contentDescription="@string/back">

                    <ImageView
                        style="@style/AsanniTopBarIcon"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>

                <!-- [EDIT TEXT] Info page title -->
                <TextView
                    style="@style/AsanniTopBarTitle"
                    android:text="@string/info_title" />
            </LinearLayout>


            <!-- Phase 5: shown when the page shows details saved on the phone (offline) -->
            <!-- [EDIT TEXT] offline_cached_note -->
            <TextView
                android:id="@+id/text_offline_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status_badge_pending"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="@string/offline_cached_note"
                android:textColor="@color/asanni_pending"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- ============ 2. PROFILE PICTURE ============ -->
            <LinearLayout
                android:id="@+id/photo_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/button_change_photo"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:clickable="true"
                    android:contentDescription="@string/profile_picture_change"
                    android:focusable="true">

                    <!-- [UI ASSET] Replace the default ASANNI avatar with an image from the ui folder.
                         Shown: custom photo > Google photo > initials > res/drawable/asanni_avatar_default.xml -->
                    <ImageView
                        android:id="@+id/info_avatar"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_avatar_circle"
                        android:clipToOutline="true"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/asanni_avatar_default" />

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_avatar_badge"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_photo_camera" />
                </FrameLayout>

                <!-- Username shown big under the photo (first + last name) -->
                <TextView
                    android:id="@+id/info_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_photo_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textColor="@color/asanni_welcome_muted"
                    android:textSize="12sp" />

                <!-- Shown after choosing a new photo: preview first, then save or cancel -->
                <LinearLayout
                    android:id="@+id/photo_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <!-- [EDIT TEXT] Cancel new photo -->
                    <TextView
                        android:id="@+id/button_cancel_photo"
                        style="@style/AsanniTextButton"
                        android:text="@string/cancel"
                        android:textColor="@color/asanni_welcome_muted" />

                    <!-- [EDIT TEXT] Save new photo -->
                    <TextView
                        android:id="@+id/button_save_photo"
                        style="@style/AsanniTextButton"
                        android:text="@string/info_save_photo" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 3. NAME ============ -->
            <!-- [EDIT TEXT] Name section label -->
            <TextView
                style="@style/AsanniSectionLabel"
                android:text="@string/info_name_section" />

            <LinearLayout
                android:id="@+id/name_card"
                style="@style/AsanniCard"
                android:padding="16dp">

                <!-- [EDIT TEXT] First name label -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:labelFor="@+id/input_first_name"
                    android:text="@string/first_name_label" />

                <EditText
                    android:id="@+id/input_first_name"
                    style="@style/AsanniTextField"
                    android:autofillHints="personGivenName"
                    android:hint="@string/first_name_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="50" />

                <TextView
                    android:id="@+id/text_first_name_error"
                    style="@style/AsanniFieldHelper"
                    android:textColor="@color/asanni_welcome_accent"
                    android:visibility="gone" />

                <!-- [EDIT TEXT] Middle name label (optional) -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:layout_marginTop="14dp"
                    android:labelFor="@+id/input_middle_name"
                    android:text="@string/middle_name_label" />

                <EditText
                    android:id="@+id/input_middle_name"
                    style="@style/AsanniTextField"
                    android:autofillHints="personMiddleName"
                    android:hint="@string/middle_name_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="50" />

                <TextView
                    android:id="@+id/text_middle_name_error"
                    style="@style/AsanniFieldHelper"
                    android:textColor="@color/asanni_welcome_accent"
                    android:visibility="gone" />

                <!-- [EDIT TEXT] Last name label -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:layout_marginTop="14dp"
                    android:labelFor="@+id/input_last_name"
                    android:text="@string/last_name_label" />

                <EditText
                    android:id="@+id/input_last_name"
                    style="@style/AsanniTextField"
                    android:autofillHints="personFamilyName"
                    android:hint="@string/last_name_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="50" />

                <TextView
                    android:id="@+id/text_last_name_error"
                    style="@style/AsanniFieldHelper"
                    android:textColor="@color/asanni_welcome_accent"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/button_save_names"
                    style="@style/AsanniPrimaryButton"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp">

                    <ProgressBar
                        android:id="@+id/names_progress"
                        style="@style/AsanniButtonProgress" />

                    <!-- [EDIT TEXT] Save name button -->
                    <TextView
                        android:id="@+id/names_label"
                        style="@style/AsanniPrimaryButtonLabel"
                        android:text="@string/info_save_names" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 4. CONTACT ============ -->
            <!-- [EDIT TEXT] Contact section label -->
            <TextView
                style="@style/AsanniSectionLabel"
                android:text="@string/info_contact_section" />

            <LinearLayout
                android:id="@+id/contact_card"
                style="@style/AsanniCard"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <!-- Email: read-only, comes from the Google account -->
                <LinearLayout
                    android:id="@+id/row_email"
                    style="@style/AsanniSettingsRow"
                    android:background="@null"
                    android:clickable="false"
                    android:focusable="true">

                    <ImageView
                        style="@style/AsanniSettingsRowIcon"
                        android:src="@drawable/ic_email" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <!-- [EDIT TEXT] Email label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/email_label"
                            android:textColor="@color/asanni_welcome_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/value_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/asanni_welcome_ink"
                            android:textIsSelectable="false"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_lock"
                        android:tint="@color/asanni_chevron" />
                </LinearLayout>

                <View style="@style/AsanniDivider" />

                <!-- Contact number: change = Firebase verification -->
                <LinearLayout
                    android:id="@+id/row_phone"
                    style="@style/AsanniSettingsRow">

                    <ImageView
                        style="@style/AsanniSettingsRowIcon"
                        android:src="@drawable/ic_phone" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <!-- [EDIT TEXT] Contact number label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_number_label"
                            android:textColor="@color/asanni_welcome_muted"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/value_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/asanni_welcome_ink"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/badge_phone_verified"
                                style="@style/AsanniBadgeVerified"
                                android:text="@string/phone_status_verified"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/badge_phone_pending"
                                style="@style/AsanniBadgePending"
                                android:text="@string/phone_status_not_verified"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- [EDIT TEXT] Change / Verify -->
                    <TextView
                        android:id="@+id/action_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:text="@string/phone_change"
                        android:textColor="@color/asanni_welcome_accent"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 5. STATUS ============ -->
            <TextView
                android:id="@+id/text_status"
                style="@style/AsanniStatusText"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="0dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <!-- ============ 6. SIGN OUT ============ -->
            <!-- [EDIT TEXT] Sign out -->
            <TextView
                android:id="@+id/button_sign_out"
                style="@style/AsanniSecondaryButton"
                android:layout_marginTop="16dp"
                android:drawablePadding="10dp"
                android:text="@string/sign_out" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>