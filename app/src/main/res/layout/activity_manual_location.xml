<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - Manual Location form  (NEW)
    Location: app/src/main/res/layout/activity_manual_location.xml

    No reference screenshot exists for this page. It is designed in the same visual language
    as Allow Location: warm background, back button top bar, bold heading, muted description,
    white rounded fields (56dp), red pill primary button.

      1. Top bar        back + "Enter your area"
      2. Heading + description
      3. Country        fixed to Pakistan (lock icon, not tappable)
      4. City           opens a searchable list (Firestore catalogue)
      5. Area           opens a searchable list of areas of the chosen city
      6. Status line    save errors / slow-connection notice
      7. Save button
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/manual_location_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_welcome_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- ============ 1. TOP BAR ============ -->
            <LinearLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/button_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:contentDescription="@string/back"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_close_button"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>

                <!-- [EDIT TEXT] Small top title -->
                <TextView
                    android:id="@+id/text_top_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/manual_location_top_title"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ============ 2. HEADING ============ -->
            <!-- [EDIT TEXT] Manual form heading -->
            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:lineSpacingMultiplier="1.05"
                android:text="@string/manual_location_title"
                android:textColor="@color/asanni_welcome_ink"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:targetApi="p" />

            <!-- [EDIT TEXT] Why the location is needed -->
            <TextView
                android:id="@+id/text_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/manual_location_description"
                android:textColor="@color/asanni_welcome_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <!-- ============ 3. COUNTRY (fixed) ============ -->
                <!-- [EDIT TEXT] Country field label -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:text="@string/country_label" />

                <LinearLayout
                    android:id="@+id/field_country"
                    style="@style/AsanniField"
                    android:contentDescription="@string/country_field_description"
                    android:enabled="false"
                    android:focusable="true">

                    <ImageView
                        style="@style/AsanniFieldIcon"
                        android:src="@drawable/ic_flag" />

                    <TextView
                        style="@style/AsanniFieldValue"
                        android:text="@string/country_pakistan" />

                    <ImageView
                        style="@style/AsanniFieldTrailing"
                        android:src="@drawable/ic_lock" />
                </LinearLayout>

                <!-- [EDIT TEXT] Country helper -->
                <TextView
                    style="@style/AsanniFieldHelper"
                    android:text="@string/country_helper" />

                <!-- ============ 4. CITY ============ -->
                <!-- [EDIT TEXT] City field label -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/city_label" />

                <LinearLayout
                    android:id="@+id/field_city"
                    style="@style/AsanniField"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/AsanniFieldIcon"
                        android:src="@drawable/ic_location_pin" />

                    <!-- [EDIT TEXT] City placeholder: city_placeholder -->
                    <TextView
                        android:id="@+id/field_city_value"
                        style="@style/AsanniFieldValue"
                        android:hint="@string/city_placeholder" />

                    <ProgressBar
                        android:id="@+id/field_city_progress"
                        style="@style/AsanniFieldProgress" />

                    <ImageView
                        android:id="@+id/field_city_trailing"
                        style="@style/AsanniFieldTrailing"
                        android:src="@drawable/ic_expand_more" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_city_message"
                    style="@style/AsanniFieldHelper"
                    android:visibility="gone" />

                <!-- ============ 5. AREA ============ -->
                <!-- [EDIT TEXT] Area field label -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/area_label" />

                <LinearLayout
                    android:id="@+id/field_area"
                    style="@style/AsanniField"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/AsanniFieldIcon"
                        android:src="@drawable/ic_near_me" />

                    <!-- [EDIT TEXT] Area placeholder: area_placeholder / area_placeholder_no_city -->
                    <TextView
                        android:id="@+id/field_area_value"
                        style="@style/AsanniFieldValue"
                        android:hint="@string/area_placeholder_no_city" />

                    <ProgressBar
                        android:id="@+id/field_area_progress"
                        style="@style/AsanniFieldProgress" />

                    <ImageView
                        android:id="@+id/field_area_trailing"
                        style="@style/AsanniFieldTrailing"
                        android:src="@drawable/ic_expand_more" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_area_message"
                    style="@style/AsanniFieldHelper"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Flexible space keeps the button at the bottom on tall screens -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/bottom_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ============ 6. STATUS ============ -->
                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textColor="@color/asanni_welcome_accent"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- ============ 7. SAVE BUTTON ============ -->
                <LinearLayout
                    android:id="@+id/button_save"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_get_started_button"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <ProgressBar
                        android:id="@+id/save_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:indeterminateTint="@color/asanni_welcome_on_accent"
                        android:visibility="gone" />

                    <!-- [EDIT TEXT] Save Location button (save_location_button) -->
                    <TextView
                        android:id="@+id/save_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/save_location_button"
                        android:textColor="@color/asanni_welcome_on_accent"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>