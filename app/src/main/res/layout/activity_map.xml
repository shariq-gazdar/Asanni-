<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - full-screen Map  (NEW in phase 7)   Logic: ui/MapActivity.java
    Location: app/src/main/res/layout/activity_map.xml

    Built from the Map reference image:
      top:     back arrow (to Discover) · "Explore <city>" search · filter button
      middle:  REAL interactive map (MapLibre + OpenFreeMap / OpenStreetMap), restaurant markers,
               your location (blue dot + accuracy circle, only with a real GPS fix)
      bottom:  floating panel: "Nearest live tables · 18 places", the first result card,
               marker legend (Free now / Wait time / Full); swipe up for more results.
    No bottom navigation on this screen (it's its own screen; Back returns to Discover).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_map_land">

    <!-- The real map. Never replaced by a picture. -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/map_search_hint_plain" />

    <!-- Map loading / error (on top of the map, below the controls) -->
    <LinearLayout
        android:id="@+id/map_status"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_map_banner"
        android:elevation="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <ProgressBar
            android:id="@+id/map_status_progress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:indeterminateTint="@color/asanni_welcome_accent" />

        <TextView
            android:id="@+id/map_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/map_loading"
            android:textColor="@color/asanni_welcome_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/map_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/map_error_text"
            android:textColor="@color/asanni_discover_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/map_status_retry"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_get_started_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="120dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/map_retry"
            android:textColor="@color/asanni_welcome_on_accent"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ============ TOP: back · search · filters (+ messages below) ============ -->
    <LinearLayout
        android:id="@+id/map_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- [UI ASSET] Back arrow: res/drawable/ic_arrow_back.xml -->
            <FrameLayout
                android:id="@+id/map_back"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_map_control"
                android:clickable="true"
                android:contentDescription="@string/map_back"
                android:elevation="3dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/asanni_welcome_ink" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/map_search_bar"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_map_search"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:id="@+id/map_search_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    android:tint="@color/asanni_welcome_ink" />

                <!-- [EDIT TEXT] Map search hint: map_search_hint ("Explore %1$s") -->
                <EditText
                    android:id="@+id/map_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:maxLength="60"
                    android:maxLines="1"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textColorHint="@color/asanni_welcome_ink"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/map_search_clear"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/discover_search_clear"
                    android:padding="10dp"
                    android:src="@drawable/ic_clear_circle"
                    android:tint="@color/asanni_discover_muted"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- [UI ASSET] Filter icon: res/drawable/ic_tune.xml -->
            <FrameLayout
                android:id="@+id/map_filter_button"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_map_control"
                android:clickable="true"
                android:contentDescription="@string/map_filters"
                android:elevation="3dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tune"
                    android:tint="@color/asanni_welcome_ink" />

                <View
                    android:id="@+id/map_filter_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="11dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_filter_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Filters limit the markers: say so (the default map shows every registered restaurant) -->
        <LinearLayout
            android:id="@+id/map_filter_notice"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_map_search"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_filter_notice"
                android:textColor="@color/asanni_welcome_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/map_filter_clear"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/map_filter_clear"
                android:textColor="@color/asanni_welcome_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Location explanation / GPS off / permission denied (only when relevant) -->
        <LinearLayout
            android:id="@+id/map_location_banner"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_map_banner"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/map_location_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/asanni_welcome_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/map_location_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/asanni_discover_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/map_location_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/asanni_discover_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/map_location_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_get_started_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="@color/asanni_welcome_on_accent"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ BOTTOM: my-location button + results panel ============ -->
    <LinearLayout
        android:id="@+id/map_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- [UI ASSET] My-location icon: res/drawable/ic_my_location.xml -->
        <FrameLayout
            android:id="@+id/map_my_location"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_map_control"
            android:clickable="true"
            android:contentDescription="@string/map_my_location"
            android:elevation="3dp"
            android:focusable="true">

            <ImageView
                android:id="@+id/map_my_location_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_my_location"
                android:tint="@color/asanni_welcome_ink" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/map_panel"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_map_panel"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <!-- Drag handle: swipe up = more results, swipe down = fewer; tap toggles -->
            <FrameLayout
                android:id="@+id/map_panel_handle"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:clickable="true"
                android:contentDescription="@string/map_panel_expand"
                android:focusable="true">

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sheet_handle"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/map_panel_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- [EDIT TEXT] map_panel_nearest / map_panel_area / map_panel_results -->
                <TextView
                    android:id="@+id/map_panel_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/map_panel_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/asanni_discover_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/map_panel_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/asanni_discover_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <include
                android:id="@+id/map_hero"
                layout="@layout/item_map_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <!-- Actions for the selected restaurant -->
            <LinearLayout
                android:id="@+id/map_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/map_action_directions"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_get_started_button"
                    android:clickable="true"
                    android:contentDescription="@string/map_directions"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_directions"
                        android:tint="@color/asanni_welcome_on_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:text="@string/map_directions"
                        android:textColor="@color/asanni_welcome_on_accent"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/map_action_details"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_outline_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/map_details"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/map_action_external"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_outline_pill"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/map_open_in_maps"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Route view: travel modes, route choices, honest note, close -->
            <LinearLayout
                android:id="@+id/map_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/route_modes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/route_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/asanni_discover_muted"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/route_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/route_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/route_estimate_note"
                    android:textColor="@color/asanni_discover_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/route_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/route_retry"
                        android:textColor="@color/asanni_welcome_accent"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/route_close"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/route_close"
                        android:textColor="@color/asanni_welcome_ink"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Marker legend (reference chips: Free now / Wait time / Full) - explains the colors -->
            <LinearLayout
                android:id="@+id/map_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <include
                    android:id="@+id/legend_free"
                    layout="@layout/view_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/legend_wait"
                    layout="@layout/view_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" />

                <include
                    android:id="@+id/legend_full"
                    layout="@layout/view_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/map_missing_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/asanni_discover_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- More results (visible when the panel is swiped up) -->
            <ListView
                android:id="@+id/map_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbarStyle="outsideOverlay"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>