<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - Notification explanation (before Android's permission dialog)  (NEW in phase 4)
    Location: app/src/main/res/layout/activity_notification_permission.xml
    Bell illustration, why ASANNI may notify, "Allow notifications" / "Not now".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_welcome_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- [UI ASSET] Replace with a notification illustration from the ui folder:
                     add res/drawable/notification_illustration.png and set it as src here. -->
                <FrameLayout
                    android:id="@+id/bell"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/bg_notification_icon"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notifications"
                        android:tint="@color/asanni_welcome_accent" />
                </FrameLayout>

                <!-- [EDIT TEXT] Notification permission title -->
                <TextView
                    android:id="@+id/text_title"
                    style="@style/AsanniPageTitle"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:text="@string/notification_permission_title"
                    tools:targetApi="p" />

                <!-- [EDIT TEXT] Why ASANNI may send notifications -->
                <TextView
                    android:id="@+id/text_description"
                    style="@style/AsanniPageDescription"
                    android:gravity="center"
                    android:text="@string/notification_permission_description"
                    android:textSize="14sp" />

                <!-- [EDIT TEXT] Reassurance -->
                <TextView
                    style="@style/AsanniPageDescription"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/notification_permission_note"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <LinearLayout
                android:id="@+id/bottom_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_status"
                    style="@style/AsanniStatusText"
                    android:textColor="@color/asanni_welcome_muted" />

                <LinearLayout
                    android:id="@+id/button_allow"
                    style="@style/AsanniPrimaryButton">

                    <!-- [EDIT TEXT] Allow notifications button -->
                    <TextView
                        android:id="@+id/allow_label"
                        style="@style/AsanniPrimaryButtonLabel"
                        android:text="@string/notification_permission_allow" />
                </LinearLayout>

                <!-- [EDIT TEXT] Not now button -->
                <TextView
                    android:id="@+id/button_later"
                    style="@style/AsanniSecondaryButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/notification_permission_later" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>