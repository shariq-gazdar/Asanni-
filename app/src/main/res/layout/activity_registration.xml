<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - First-time registration form  (NEW in phase 4)
    Location: app/src/main/res/layout/activity_registration.xml
    No reference image: designed in the ASANNI language (warm background, bold heading,
    white 56dp rounded fields, red pill button), and it switches with Light/Dark.

      1. Title + description           5. Language (English, fixed)
      2. Profile picture               6. Appearance (System / Light / Dark)
      3. First / Middle / Last name    7. Phone (+92) with verification status
      4. Email (from Google, locked)   8. Status + "Save and continue"
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registration_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_welcome_background">

    <ScrollView
        android:id="@+id/registration_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- [EDIT TEXT] Small step label above the title -->
            <TextView
                android:id="@+id/text_step"
                style="@style/AsanniSectionLabel"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="0dp"
                android:layout_marginStart="0dp"
                android:text="@string/registration_step_label" />

            <!-- [EDIT TEXT] Registration form title -->
            <TextView
                android:id="@+id/text_title"
                style="@style/AsanniPageTitle"
                android:layout_marginTop="6dp"
                android:text="@string/registration_title"
                tools:targetApi="p" />

            <!-- [EDIT TEXT] Registration description -->
            <TextView
                android:id="@+id/text_description"
                style="@style/AsanniPageDescription"
                android:text="@string/registration_description" />

            <!-- Loading (shown while the saved profile is read) -->
            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:indeterminateTint="@color/asanni_welcome_accent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <!-- ============ 2. PROFILE PICTURE ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/button_change_photo"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:clickable="true"
                        android:contentDescription="@string/profile_picture_change"
                        android:focusable="true">

                        <!-- [UI ASSET] Replace the default ASANNI avatar with an image from the ui folder.
                             Shown: chosen photo > Google photo > initials > res/drawable/asanni_avatar_default.xml -->
                        <ImageView
                            android:id="@+id/avatar_image"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_avatar_circle"
                            android:clipToOutline="true"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/asanni_avatar_default" />

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_avatar_badge"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            android:src="@drawable/ic_photo_camera" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- [EDIT TEXT] Profile picture field label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/profile_picture_label"
                            android:textColor="@color/asanni_welcome_ink"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/text_photo_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/profile_picture_hint_google"
                            android:textColor="@color/asanni_welcome_muted"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- [EDIT TEXT] Change photo -->
                            <TextView
                                android:id="@+id/button_pick_photo"
                                style="@style/AsanniTextButton"
                                android:layout_marginStart="-8dp"
                                android:text="@string/profile_picture_change" />

                            <!-- [EDIT TEXT] Discard the chosen photo -->
                            <TextView
                                android:id="@+id/button_remove_photo"
                                style="@style/AsanniTextButton"
                                android:text="@string/profile_picture_use_default"
                                android:textColor="@color/asanni_welcome_muted"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ 3. NAMES ============ -->
                <!-- [EDIT TEXT] First name label -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:layout_marginTop="20dp"
                    android:labelFor="@+id/input_first_name"
                    android:text="@string/first_name_label" />

                <EditText
                    android:id="@+id/input_first_name"
                    style="@style/AsanniTextField"
                    android:autofillHints="personGivenName"
                    android:hint="@string/first_name_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="50" />

                <TextView
                    android:id="@+id/text_first_name_error"
                    style="@style/AsanniFieldHelper"
                    android:textColor="@color/asanni_welcome_accent"
                    android:visibility="gone" />

                <!-- [EDIT TEXT] Middle name label (optional) -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:layout_marginTop="16dp"
                    android:labelFor="@+id/input_middle_name"
                    android:text="@string/middle_name_label" />

                <EditText
                    android:id="@+id/input_middle_name"
                    style="@style/AsanniTextField"
                    android:autofillHints="personMiddleName"
                    android:hint="@string/middle_name_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="50" />

                <TextView
                    android:id="@+id/text_middle_name_error"
                    style="@style/AsanniFieldHelper"
                    android:textColor="@color/asanni_welcome_accent"
                    android:visibility="gone" />

                <!-- [EDIT TEXT] Last name label -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:layout_marginTop="16dp"
                    android:labelFor="@+id/input_last_name"
                    android:text="@string/last_name_label" />

                <EditText
                    android:id="@+id/input_last_name"
                    style="@style/AsanniTextField"
                    android:autofillHints="personFamilyName"
                    android:hint="@string/last_name_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="50" />

                <TextView
                    android:id="@+id/text_last_name_error"
                    style="@style/AsanniFieldHelper"
                    android:textColor="@color/asanni_welcome_accent"
                    android:visibility="gone" />

                <!-- [EDIT TEXT] Username preview ("Shown as Sara Ahmed") -->
                <TextView
                    android:id="@+id/text_username_preview"
                    style="@style/AsanniFieldHelper" />

                <!-- ============ 4. EMAIL (read-only, from the Google account) ============ -->
                <!-- [EDIT TEXT] Email label -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/email_label" />

                <LinearLayout
                    android:id="@+id/field_email"
                    style="@style/AsanniField"
                    android:enabled="false"
                    android:focusable="true">

                    <ImageView
                        style="@style/AsanniFieldIcon"
                        android:src="@drawable/ic_email" />

                    <TextView
                        android:id="@+id/text_email"
                        style="@style/AsanniFieldValue" />

                    <ImageView
                        style="@style/AsanniFieldTrailing"
                        android:src="@drawable/ic_lock" />
                </LinearLayout>

                <!-- ============ 5. LANGUAGE (English only) ============ -->
                <!-- [EDIT TEXT] Language label -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/language_label" />

                <LinearLayout
                    android:id="@+id/field_language"
                    style="@style/AsanniField"
                    android:enabled="false"
                    android:focusable="true">

                    <ImageView
                        style="@style/AsanniFieldIcon"
                        android:src="@drawable/ic_language" />

                    <TextView
                        android:id="@+id/text_language"
                        style="@style/AsanniFieldValue" />

                    <ImageView
                        style="@style/AsanniFieldTrailing"
                        android:src="@drawable/ic_lock" />
                </LinearLayout>

                <TextView
                    style="@style/AsanniFieldHelper"
                    android:text="@string/language_helper" />

                <!-- ============ 6. APPEARANCE ============ -->
                <!-- [EDIT TEXT] Appearance selector label -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/appearance_label" />

                <include
                    android:id="@+id/appearance_selector"
                    layout="@layout/view_appearance_selector" />

                <!-- ============ 7. PHONE ============ -->
                <!-- [EDIT TEXT] Phone number field label -->
                <TextView
                    style="@style/AsanniFieldLabel"
                    android:layout_marginTop="20dp"
                    android:labelFor="@+id/input_phone"
                    android:text="@string/phone_number_label" />

                <!-- Not verified yet: +92 field + Verify button -->
                <LinearLayout
                    android:id="@+id/phone_input_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/field_phone"
                        style="@style/AsanniField"
                        android:paddingStart="0dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_phone_prefix"
                            android:contentDescription="@string/phone_country_code_description"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:minHeight="56dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="14dp"
                            android:text="@string/phone_country_code"
                            android:textColor="@color/asanni_welcome_ink"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/input_phone"
                            style="@style/AsanniFieldInput"
                            android:layout_marginStart="12dp"
                            android:autofillHints="phoneNational"
                            android:hint="@string/phone_number_hint"
                            android:imeOptions="actionDone"
                            android:inputType="phone"
                            android:maxLength="16" />

                        <!-- [EDIT TEXT] Not verified badge -->
                        <TextView
                            style="@style/AsanniBadgePending"
                            android:layout_marginEnd="2dp"
                            android:text="@string/phone_status_not_verified" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_phone_message"
                        style="@style/AsanniFieldHelper"
                        android:text="@string/phone_verification_required" />

                    <!-- [EDIT TEXT] Verify number button -->
                    <TextView
                        android:id="@+id/button_verify_phone"
                        style="@style/AsanniSecondaryButton"
                        android:layout_marginTop="10dp"
                        android:text="@string/phone_verify_button" />
                </LinearLayout>

                <!-- Verified: number + badge + Change -->
                <LinearLayout
                    android:id="@+id/phone_verified_group"
                    style="@style/AsanniField"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <ImageView
                        style="@style/AsanniFieldIcon"
                        android:src="@drawable/ic_phone" />

                    <TextView
                        android:id="@+id/text_phone_verified"
                        style="@style/AsanniFieldValue" />

                    <!-- [EDIT TEXT] Verified badge -->
                    <TextView
                        style="@style/AsanniBadgeVerified"
                        android:text="@string/phone_status_verified" />

                    <TextView
                        android:id="@+id/button_change_phone"
                        style="@style/AsanniTextButton"
                        android:text="@string/phone_change" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <LinearLayout
                android:id="@+id/bottom_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_status"
                    style="@style/AsanniStatusText" />

                <LinearLayout
                    android:id="@+id/button_save"
                    style="@style/AsanniPrimaryButton">

                    <ProgressBar
                        android:id="@+id/save_progress"
                        style="@style/AsanniButtonProgress" />

                    <!-- [EDIT TEXT] Save button (registration_save_button) -->
                    <TextView
                        android:id="@+id/save_label"
                        style="@style/AsanniPrimaryButtonLabel"
                        android:text="@string/registration_save_button" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>