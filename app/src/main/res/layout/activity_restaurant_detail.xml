<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - Restaurant Details  (REWRITTEN in phase 8 from the details reference image)
    Location: app/src/main/res/layout/activity_restaurant_detail.xml   Logic: ui/RestaurantDetailActivity.java

    One screen for EVERY restaurant (opened from Discover, See All, Map and Saved). No bottom bar.
      cover photo (coverUrl, else the XML placeholder) · back (top-left) · save (top-right)
      name ................................... rating / "No reviews yet"
      cuisines · area · price
      availability box (green when current)
      distance box | wait box
      Address (heading changed from "Directions")
      Get details (replaces the Outdoor / Family / Valet tags)
      Get directions (the ONLY thing on this page that asks for a road route)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_discover_background">

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ COVER ============ -->
            <FrameLayout
                android:id="@+id/detail_cover_box"
                android:layout_width="match_parent"
                android:layout_height="272dp">

                <!-- [UI ASSET] Restaurant cover placeholder: res/drawable/restaurant_cover_placeholder.xml
                     (replace with an image from ui/). The real coverUrl from Firestore replaces it. -->
                <ImageView
                    android:id="@+id/detail_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/restaurant_cover_placeholder"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_cover_scrim"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="28dp">

                <!-- Development dummy restaurant only -->
                <TextView
                    android:id="@+id/detail_test_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_test_banner"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/detail_test_banner"
                    android:textColor="@color/asanni_pending"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Name + rating -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detail_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/asanni_welcome_ink"
                        android:textSize="28sp" />

                    <!-- Read-only reviews: real average + count, or "No reviews yet" -->
                    <LinearLayout
                        android:id="@+id/detail_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:alpha="0"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/detail_rating_star"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="5dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_star_outline"
                            android:tint="@color/asanni_badge_wait_text" />

                        <TextView
                            android:id="@+id/detail_rating_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/asanni_welcome_ink"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- cuisines · area · price -->
                <TextView
                    android:id="@+id/detail_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.1"
                    android:textColor="@color/asanni_discover_muted"
                    android:textSize="15sp" />

                <!-- ============ AVAILABILITY ============ -->
                <LinearLayout
                    android:id="@+id/detail_avail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_avail_neutral"
                    android:gravity="center_vertical"
                    android:minHeight="86dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detail_avail_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="@color/asanni_badge_neutral_text"
                            android:textSize="27sp" />

                        <TextView
                            android:id="@+id/detail_avail_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/asanni_badge_neutral_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- [UI ASSET] Live signal icon: res/drawable/ic_live_signal.xml -->
                    <ImageView
                        android:id="@+id/detail_avail_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/avail_icon_description"
                        android:src="@drawable/ic_live_signal"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ============ DISTANCE | WAIT ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/detail_distance_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_detail_box"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_navigation_outline"
                            android:tint="@color/asanni_welcome_accent" />

                        <TextView
                            android:id="@+id/detail_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/asanni_welcome_ink"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/detail_distance_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/asanni_discover_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="14dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/detail_wait_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_detail_box"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_schedule"
                            android:tint="@color/asanni_welcome_accent" />

                        <TextView
                            android:id="@+id/detail_wait"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/asanni_welcome_ink"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/detail_wait_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/asanni_discover_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ ADDRESS (heading changed from "Directions") ============ -->
                <LinearLayout
                    android:id="@+id/detail_address_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:longClickable="true"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="14dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_address_icon">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_location_pin"
                            android:tint="@color/asanni_welcome_ink" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/address_heading"
                            android:textColor="@color/asanni_discover_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/detail_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingMultiplier="1.1"
                            android:textColor="@color/asanni_welcome_ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/asanni_divider" />

                <!-- ============ GET DETAILS (replaces the reference's tags) ============ -->
                <TextView
                    android:id="@+id/detail_get_details"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_get_details"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_info_outline"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/asanni_welcome_ink"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/detail_get_details"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="16sp" />

                <!-- Directions problems (missing location, route failed) + Retry -->
                <LinearLayout
                    android:id="@+id/detail_directions_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_info_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/detail_directions_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/asanni_welcome_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/detail_directions_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/asanni_welcome_accent"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- ============ GET DIRECTIONS ============ -->
                <LinearLayout
                    android:id="@+id/detail_get_directions"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_get_started_button"
                    android:clickable="true"
                    android:contentDescription="@string/detail_get_directions"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/detail_directions_progress"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:indeterminateTint="@color/asanni_welcome_on_accent"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/detail_directions_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_navigation_outline"
                        android:tint="@color/asanni_welcome_on_accent" />

                    <TextView
                        android:id="@+id/detail_directions_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/detail_get_directions"
                        android:textColor="@color/asanni_welcome_on_accent"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Loading / not found (shown instead of the content) -->
            <ProgressBar
                android:id="@+id/detail_progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:contentDescription="@string/loading_description"
                android:indeterminateTint="@color/asanni_welcome_accent"
                android:visibility="gone" />

            <include
                android:id="@+id/detail_state"
                layout="@layout/view_discover_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="22dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ============ FLOATING TOP BUTTONS (over the cover) ============ -->
    <FrameLayout
        android:id="@+id/detail_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <!-- [UI ASSET] Back arrow: res/drawable/ic_arrow_back.xml -->
        <FrameLayout
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="@drawable/bg_detail_round_button"
            android:clickable="true"
            android:contentDescription="@string/detail_back"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/asanni_welcome_ink" />
        </FrameLayout>

        <!-- [UI ASSET] Save: res/drawable/ic_nav_saved.xml (outline) / ic_bookmark_filled.xml (saved) -->
        <FrameLayout
            android:id="@+id/button_save"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="@drawable/bg_detail_round_button"
            android:clickable="true"
            android:contentDescription="@string/detail_save"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:id="@+id/button_save_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_saved"
                android:tint="@color/asanni_welcome_ink" />

            <ProgressBar
                android:id="@+id/button_save_progress"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:indeterminateTint="@color/asanni_welcome_accent"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>