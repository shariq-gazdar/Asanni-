<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - Restaurant details  (NEW in phase 6, intentionally minimal)
    Location: app/src/main/res/layout/activity_restaurant_detail.xml   Logic: ui/RestaurantDetailActivity.java
    Shows ONLY information the desktop app actually provides; anything missing is left out.
    Lines are added in code (layout/item_detail_line.xml).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_discover_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout style="@style/AsanniTopBar">

                <FrameLayout
                    android:id="@+id/button_back"
                    style="@style/AsanniTopBarButton"
                    android:contentDescription="@string/back">

                    <ImageView
                        style="@style/AsanniTopBarIcon"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_restaurant_card"
                    android:clipToOutline="true">

                    <!-- [UI ASSET] Restaurant logo placeholder; actual restaurant logos come from
                         Firestore. Fallback: res/drawable/restaurant_placeholder.xml -->
                    <ImageView
                        android:id="@+id/detail_logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/restaurant_placeholder" />
                </FrameLayout>

                <TextView
                    android:id="@+id/detail_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:accessibilityHeading="true"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/detail_cuisine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/asanni_discover_muted"
                    android:textSize="15sp" />

                <include
                    android:id="@+id/detail_badge"
                    layout="@layout/view_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:accessibilityHeading="true"
                    android:letterSpacing="0.04"
                    android:text="@string/detail_status_heading"
                    android:textAllCaps="true"
                    android:textColor="@color/asanni_welcome_accent"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/detail_status_lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_restaurant_card"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/detail_location_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:accessibilityHeading="true"
                    android:letterSpacing="0.04"
                    android:text="@string/detail_location_heading"
                    android:textAllCaps="true"
                    android:textColor="@color/asanni_welcome_accent"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/detail_location_lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_restaurant_card"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:id="@+id/detail_call"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_get_started_button"
                    android:clickable="true"
                    android:contentDescription="@string/detail_call"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_call"
                        android:tint="@color/asanni_welcome_on_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:text="@string/detail_call"
                        android:textColor="@color/asanni_welcome_on_accent"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/detail_progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="80dp"
                android:contentDescription="@string/loading_description"
                android:indeterminateTint="@color/asanni_welcome_accent" />

            <include
                android:id="@+id/detail_state"
                layout="@layout/view_discover_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>