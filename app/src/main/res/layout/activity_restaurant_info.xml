<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - Restaurant information ("Get details" on Restaurant Details)  (NEW in phase 8)
    Location: app/src/main/res/layout/activity_restaurant_info.xml   Logic: ui/RestaurantInfoActivity.java
    Shows ONLY fields the desktop app really provides (no invented menus, hours or facilities).
    Rows are added in code with layout/item_info_row.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rinfo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_discover_background"
    android:orientation="vertical">

    <LinearLayout
        style="@style/AsanniTopBar"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <FrameLayout
            android:id="@+id/button_back"
            style="@style/AsanniTopBarButton"
            android:contentDescription="@string/back">

            <ImageView
                style="@style/AsanniTopBarIcon"
                android:src="@drawable/ic_arrow_back" />
        </FrameLayout>

        <!-- [EDIT TEXT] rinfo_title -->
        <TextView
            android:id="@+id/rinfo_title"
            style="@style/AsanniTopBarTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/rinfo_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rinfo_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/rinfo_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textColor="@color/asanni_welcome_ink"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/rinfo_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_test_banner"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/detail_test_banner"
                android:textColor="@color/asanni_pending"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/rinfo_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- [EDIT TEXT] rinfo_note: honest note about missing information -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_info_box"
                android:lineSpacingMultiplier="1.15"
                android:padding="14dp"
                android:text="@string/rinfo_note"
                android:textColor="@color/asanni_discover_muted"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/rinfo_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:contentDescription="@string/loading_description"
                android:indeterminateTint="@color/asanni_welcome_accent" />

            <!-- PHASE 8: offline / error state with Retry -->
            <include
                android:id="@+id/rinfo_state"
                layout="@layout/view_discover_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>