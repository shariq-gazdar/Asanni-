<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - See All restaurants  (NEW in phase 6)
    Location: app/src/main/res/layout/activity_restaurant_list.xml   Logic: ui/RestaurantListActivity.java
    Every restaurant in the browsing area that matches the search + filters (not only the three
    Featured ones). Rows: layout/item_restaurant_row.xml (recycled by the ListView).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_discover_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <LinearLayout style="@style/AsanniTopBar">

            <FrameLayout
                android:id="@+id/button_back"
                style="@style/AsanniTopBarButton"
                android:contentDescription="@string/back">

                <ImageView
                    style="@style/AsanniTopBarIcon"
                    android:src="@drawable/ic_arrow_back" />
            </FrameLayout>

            <!-- [EDIT TEXT] Title: list_title in strings_discover.xml -->
            <TextView
                android:id="@+id/list_title"
                style="@style/AsanniTopBarTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Same search bar + filter button as Discover -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_discover_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:tint="@color/asanni_discover_muted" />

            <EditText
                android:id="@+id/list_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/discover_search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLength="60"
                android:maxLines="1"
                android:textColor="@color/asanni_welcome_ink"
                android:textColorHint="@color/asanni_discover_muted"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/list_search_clear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/discover_search_clear"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                android:tint="@color/asanni_discover_muted"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/list_filter_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/discover_filters"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tune"
                    android:tint="@color/asanni_welcome_ink" />

                <View
                    android:id="@+id/list_filter_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_filter_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/list_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/asanni_discover_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:scrollbarStyle="outsideOverlay" />

        <ProgressBar
            android:id="@+id/list_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:contentDescription="@string/loading_description"
            android:indeterminateTint="@color/asanni_welcome_accent"
            android:visibility="gone" />

        <include
            android:id="@+id/list_state"
            layout="@layout/view_discover_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>