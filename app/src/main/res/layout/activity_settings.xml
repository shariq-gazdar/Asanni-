<?xml version="1.0" encoding="utf-8"?>
<!--
    ASANNI - Settings  (NEW in phase 4)
    Location: app/src/main/res/layout/activity_settings.xml

    Follows the Settings reference screenshot (shown there in Dark mode; Light mode uses the
    same layout with the light colors):
      1. Top bar               back + "Settings"
      2. Profile card          avatar (initials/photo), name, "Diner · City", arrow -> Info
      3. APPEARANCE            System / Light / Dark pills
      4. Card with 3 rows      Home area (-> change address) / Live availability alerts / Language
      5. Restaurant partner    information card (see note below)
      6. Footer                app name + version
    NOTE: the reference's "Switch role" button is left out: in phase 3 you made the Android
    app diner-only (restaurant partners use separate software), so there is no role to switch.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asanni_welcome_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- ============ 1. TOP BAR ============ -->
            <LinearLayout
                android:id="@+id/top_bar"
                style="@style/AsanniTopBar">

                <FrameLayout
                    android:id="@+id/button_back"
                    style="@style/AsanniTopBarButton"
                    android:contentDescription="@string/back">

                    <ImageView
                        style="@style/AsanniTopBarIcon"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>

                <!-- [EDIT TEXT] Settings page title -->
                <TextView
                    style="@style/AsanniTopBarTitle"
                    android:text="@string/settings_title" />
            </LinearLayout>


            <!-- Phase 5: shown when the page shows details saved on the phone (offline) -->
            <!-- [EDIT TEXT] offline_cached_note -->
            <TextView
                android:id="@+id/text_offline_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status_badge_pending"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="@string/offline_cached_note"
                android:textColor="@color/asanni_pending"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- ============ 2. PROFILE CARD (tap -> Info) ============ -->
            <LinearLayout
                android:id="@+id/row_profile"
                style="@style/AsanniCard"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- [UI ASSET] Profile picture: custom photo > Google photo > initials > default avatar -->
                <ImageView
                    android:id="@+id/settings_avatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clipToOutline="true"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/asanni_avatar_default" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Username = first name + last name (from the profile) -->
                    <TextView
                        android:id="@+id/settings_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/asanni_welcome_ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- [EDIT TEXT] Subtitle under the name (settings_profile_subtitle) -->
                    <TextView
                        android:id="@+id/settings_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/asanni_welcome_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView style="@style/AsanniSettingsChevron" />
            </LinearLayout>

            <!-- ============ 3. APPEARANCE ============ -->
            <!-- [EDIT TEXT] Appearance section label -->
            <TextView
                style="@style/AsanniSectionLabel"
                android:text="@string/appearance_label" />

            <include
                android:id="@+id/appearance_selector"
                layout="@layout/view_appearance_selector" />

            <!-- ============ 4. ROWS ============ -->
            <LinearLayout
                style="@style/AsanniCard"
                android:layout_marginTop="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <!-- Home area -> same manual city/area form as onboarding -->
                <LinearLayout
                    android:id="@+id/row_address"
                    style="@style/AsanniSettingsRow">

                    <ImageView
                        style="@style/AsanniSettingsRowIcon"
                        android:src="@drawable/ic_location_pin" />

                    <!-- [EDIT TEXT] Settings address label -->
                    <TextView
                        style="@style/AsanniSettingsRowLabel"
                        android:text="@string/address_label" />

                    <TextView
                        android:id="@+id/value_address"
                        style="@style/AsanniSettingsRowValue" />

                    <ImageView style="@style/AsanniSettingsChevron" />
                </LinearLayout>

                <View style="@style/AsanniDivider" />

                <!-- Live availability alerts -> Android notification settings for ASANNI -->
                <LinearLayout
                    android:id="@+id/row_alerts"
                    style="@style/AsanniSettingsRow">

                    <ImageView
                        style="@style/AsanniSettingsRowIcon"
                        android:src="@drawable/ic_notifications" />

                    <!-- [EDIT TEXT] Alerts row label -->
                    <TextView
                        style="@style/AsanniSettingsRowLabel"
                        android:text="@string/settings_alerts_label" />

                    <TextView
                        android:id="@+id/value_alerts"
                        style="@style/AsanniSettingsRowValue" />

                    <ImageView style="@style/AsanniSettingsChevron" />
                </LinearLayout>

                <View style="@style/AsanniDivider" />

                <!-- Language (English only for now: shows the value, not tappable) -->
                <LinearLayout
                    android:id="@+id/row_language"
                    style="@style/AsanniSettingsRow"
                    android:background="@null"
                    android:clickable="false"
                    android:focusable="true">

                    <ImageView
                        style="@style/AsanniSettingsRowIcon"
                        android:src="@drawable/ic_language" />

                    <!-- [EDIT TEXT] Language label -->
                    <TextView
                        style="@style/AsanniSettingsRowLabel"
                        android:text="@string/language_label" />

                    <TextView
                        android:id="@+id/value_language"
                        style="@style/AsanniSettingsRowValue"
                        android:layout_marginEnd="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 5. RESTAURANT PARTNER (information only) ============ -->
            <LinearLayout
                style="@style/AsanniCard"
                android:layout_marginTop="16dp"
                android:padding="16dp">

                <!-- [EDIT TEXT] Partner card title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_partner_title"
                    android:textColor="@color/asanni_welcome_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- [EDIT TEXT] Partner card description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.1"
                    android:text="@string/settings_partner_description"
                    android:textColor="@color/asanni_welcome_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <!-- ============ 6. FOOTER ============ -->
            <TextView
                android:id="@+id/text_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/asanni_welcome_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>