<?xml version="1.0" encoding="utf-8"?>
<!-- Cuisine picker for Discover's Cuisine chip (NEW in phase 7). Rows are added in FilterSheet.java. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="10dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle"
        android:importantForAccessibility="no" />

    <!-- [EDIT TEXT] filter_cuisine_heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:accessibilityHeading="true"
        android:text="@string/filter_cuisine_heading"
        android:textColor="@color/asanni_welcome_ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/cuisine_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/cuisine_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>