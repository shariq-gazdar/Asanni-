<?xml version="1.0" encoding="utf-8"?>
<!--
    One "AVAILABILITY LANGUAGE" card (NEW in phase 9, from the reference): title + explanation on
    the left, colored dot + label on the right. Colors are set in code (green / peach / red).
    Location: app/src/main/res/layout/item_desc_language.xml
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_desc_card"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="84dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lang_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/lang_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:alpha="0.85"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:id="@+id/lang_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_desc_dot" />

    <TextView
        android:id="@+id/lang_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:letterSpacing="0.03"
        android:textSize="14sp" />
</LinearLayout>