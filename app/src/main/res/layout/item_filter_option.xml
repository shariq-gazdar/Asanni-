<?xml version="1.0" encoding="utf-8"?>
<!-- One choice in the filter sheet (NEW in phase 6). Location: app/src/main/res/layout/item_filter_option.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/filter_option_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/asanni_welcome_ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/filter_option_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/asanni_discover_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/filter_option_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_circle"
        android:tint="@color/asanni_welcome_accent"
        android:visibility="invisible" />
</LinearLayout>