<?xml version="1.0" encoding="utf-8"?>
<!--
    One restaurant in search results and on the See All screen (NEW in phase 6).
    Location: app/src/main/res/layout/item_restaurant_row.xml
-->
<!-- Outer frame = spacing between rows (ListView ignores margins on the row itself). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/row_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_restaurant_card"
        android:duplicateParentState="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="84dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- [UI ASSET] Restaurant logo placeholder; actual restaurant logos come from Firestore.
             Fallback image: res/drawable/restaurant_placeholder.xml -->
        <ImageView
            android:id="@+id/row_logo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_restaurant_logo_frame"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/restaurant_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/asanni_welcome_ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/row_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/asanni_discover_muted"
                android:textSize="13sp" />

            <include
                android:id="@+id/row_badge"
                layout="@layout/view_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>