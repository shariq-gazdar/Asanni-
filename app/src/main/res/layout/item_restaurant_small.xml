<?xml version="1.0" encoding="utf-8"?>
<!--
    Small Featured card (two below the big one) (NEW in phase 6).
    Location: app/src/main/res/layout/item_restaurant_small.xml
    Shows: name, availability badge, cuisine · distance (or area when GPS distance isn't known).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_restaurant_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:minHeight="120dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/asanni_welcome_ink"
        android:textSize="16sp" />

    <include
        android:id="@+id/card_badge"
        layout="@layout/view_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/card_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/asanni_discover_muted"
        android:textSize="13sp" />
</LinearLayout>