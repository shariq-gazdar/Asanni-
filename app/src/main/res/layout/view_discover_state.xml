<?xml version="1.0" encoding="utf-8"?>
<!--
    Empty / error / offline message card for Discover and See All (NEW in phase 6).
    Location: app/src/main/res/layout/view_discover_state.xml. Texts are set in code from
    strings_discover.xml ([EDIT TEXT] there).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_restaurant_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/state_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_storefront"
        android:tint="@color/asanni_discover_muted" />

    <TextView
        android:id="@+id/state_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/asanni_welcome_ink"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/state_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/asanni_discover_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/state_action"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_get_started_button"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:minWidth="160dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/asanni_welcome_on_accent"
        android:textSize="15sp" />
</LinearLayout>